# =============================================================================
# Summary.cmake - print what this configure will build
#
# Included last. One block at the end of the configure output answers "what
# did I just configure?" without digging through CMakeCache.txt.
# =============================================================================
include_guard(DIRECTORY)

if(NOT PROJECT_IS_TOP_LEVEL)
    return()
endif()

# _grocery_summary_line(<label> <value>...) - one aligned "label : value" line.
function(_grocery_summary_line label)
    string(LENGTH "${label}" _len)
    math(EXPR _pad "18 - ${_len}")
    string(REPEAT " " ${_pad} _spaces)
    list(JOIN ARGN " " _value)
    message(STATUS "  ${label}${_spaces}: ${_value}")
endfunction()

if(GROCERY_LIBRARY_MODE)
    set(_grocery_mode "library (installable package)")
else()
    set(_grocery_mode "app")
endif()
get_target_property(_grocery_lib_type ${PROJECT_NAME}_lib TYPE)

# The target architecture. On Windows CMAKE_SYSTEM_PROCESSOR is the host's, so
# use the one GROCERY_WINDOWS_TARGET_ARCH selects.
if(DEFINED GROCERY_WINDOWS_TARGET_ARCH)
    set(_grocery_proc "${GROCERY_WINDOWS_TARGET_ARCH}")
else()
    set(_grocery_proc "${CMAKE_SYSTEM_PROCESSOR}")
endif()
string(TOLOWER "${_grocery_proc}" _grocery_arch)
if(_grocery_arch MATCHES "^(x86_64|amd64)$")
    set(_grocery_arch x64)
elseif(_grocery_arch MATCHES "^(aarch64|arm64)$")
    set(_grocery_arch arm64)
elseif(_grocery_arch MATCHES "^(i386|i686|x86|win32)$")
    set(_grocery_arch x86)
endif()
if(GROCERY_SANITIZER STREQUAL "")
    set(_grocery_sanitizer "none")
else()
    set(_grocery_sanitizer "${GROCERY_SANITIZER}")
endif()

message(STATUS "")
message(STATUS "${PROJECT_NAME} ${PROJECT_VERSION} configuration:")
_grocery_summary_line("Mode" "${_grocery_mode}")
_grocery_summary_line("Target OS" "${CMAKE_SYSTEM_NAME}")
_grocery_summary_line("Target arch" "${_grocery_arch}")
_grocery_summary_line("Library type" "${_grocery_lib_type}")
_grocery_summary_line("Build type" "${CMAKE_BUILD_TYPE}")
_grocery_summary_line("Compiler" "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
if(GROCERY_USE_VCPKG)
    set(_grocery_dependencies "vcpkg")
else()
    set(_grocery_dependencies "FetchContent")
endif()
_grocery_summary_line("Dependencies" "${_grocery_dependencies}")
_grocery_summary_line("Sanitizer" "${_grocery_sanitizer}")
_grocery_summary_line("Hardening" "${GROCERY_ENABLE_HARDENING}")
if(CMAKE_COMPILE_WARNING_AS_ERROR)
    set(_grocery_werror ON)
else()
    set(_grocery_werror OFF)
endif()
_grocery_summary_line("Warnings as errors" "${_grocery_werror}")
if(GROCERY_ENABLE_LTO AND NOT GROCERY_LIBRARY_MODE AND CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE)
    set(_grocery_lto "ON (optimised configurations)")
else()
    set(_grocery_lto OFF)
endif()
_grocery_summary_line("LTO" "${_grocery_lto}")
_grocery_summary_line("Tests" "${GROCERY_BUILD_TESTS}")
_grocery_summary_line("Fuzzers" "${GROCERY_BUILD_FUZZERS}")
_grocery_summary_line("Coverage" "${GROCERY_ENABLE_COVERAGE}")
_grocery_summary_line("Install prefix" "${CMAKE_INSTALL_PREFIX}")
message(STATUS "")
